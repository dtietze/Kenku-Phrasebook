{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Skip type-checking of .d.ts files inside node_modules.
    // Required because @react-native-voice/voice 3.x imports EventSubscriptionVendor
    // from react-native, which was removed from the public exports in RN 0.77.
    "skipLibCheck": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.d.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ]
}
